# 复制成 .env，填入真实值。.env 已在 .gitignore 里，不会被提交。
#
#   cp .env.example .env
#
# 这个文件（.example）是**要提交**的——它告诉别人（和我）
# 这个项目需要哪些环境变量，而不用把真密钥交出去。

# AI 网关地址（Anthropic 格式）
AI_BASE_URL=https://api.anthropic.com

# 密钥。绝不写进代码，绝不提交。
AI_API_KEY=在这里填你的密钥

# 用哪个模型
AI_MODEL=deepseek-v4.1-flash

# 网页口令。**留空 = 不启用**，本机开发时不用输。
# 但一旦要开放到局域网（py app.py --lan），app.py 会强制要求这一行非空——
# 宁可拒绝启动，也不让一个没口令的服务在局域网上裸奔。
#
# 手机上输一次，浏览器就记住了，不用天天敲。
# 想换口令就改这一行然后重启服务。
APP_PASSWORD=
